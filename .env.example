NEXT_PUBLIC_SITE_URL=https://fekitech.vercel.app
NEXT_PUBLIC_ALTERNATE_DOMAINS=

# Fekitech chatbot
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Upstash Vector is used for Vercel-friendly retrieval.
# Create an Upstash Vector index with hosted embeddings enabled, then add:
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# Future custom-domain example:
# NEXT_PUBLIC_SITE_URL=https://fekitech.com
# NEXT_PUBLIC_ALTERNATE_DOMAINS=https://www.fekitech.com,https://fekitech.co.uk,https://www.fekitech.co.uk
